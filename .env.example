# ─────────────────────────────────────────────────────────────
# Human Compass booking — environment variables
# Copy to .env.local for local dev; add the same keys in Vercel →
# Project → Settings → Environment Variables.
# Everything here is SERVER-ONLY except NEXT_PUBLIC_*.
# ─────────────────────────────────────────────────────────────

# "google" (default) or "mock". Mock = in-memory fake calendar for demos/local UI work.
CALENDAR_PROVIDER=google

# OAuth 2.0 client (Google Cloud → APIs & Services → Credentials → OAuth client, type "Desktop app")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# From `npm run google:token`, authorised by the account that OWNS the calendar.
GOOGLE_REFRESH_TOKEN=

# The dedicated "بوصلة الإنسان" secondary calendar. Bookings are inserted here (never "primary").
# Format: xxxxxxxxxxxxxxxx@group.calendar.google.com
GOOGLE_CALENDAR_ID=

# Comma-separated calendars whose busy time blocks slots. GOOGLE_CALENDAR_ID is ALWAYS included.
# Add "primary" (the owner's main calendar) or a consultant's calendar ID if they should block too.
# The authorising account needs at least "See only free/busy" access to each one.
BUSY_CALENDAR_IDS=

# Optional: POST each booking as JSON to this URL (Make / Zapier / n8n → monday.com, Google Sheets…).
BOOKING_WEBHOOK_URL=
# Optional: if set, requests carry X-Signature: sha256=<HMAC of the body with this secret>.
BOOKING_WEBHOOK_SECRET=

# Optional: add every booking as an item on a monday.com board.
# Token: monday → your avatar → Developers → My access tokens (acts as that user — use a
# dedicated user with access to this board only, if you can). Column mapping: config/monday.ts
MONDAY_API_TOKEN=
# From the board URL: https://lgnd-co.monday.com/boards/5108026540 → 5108026540
MONDAY_BOARD_ID=
# Optional: group ID for new leads (default in config/monday.ts: «ردود وحجوزات»)
MONDAY_GROUP_ID=

# Public site URL (used for metadata / Open Graph).
NEXT_PUBLIC_SITE_URL=https://example.com

# Content locale: "ar" (default). "en" once content/en.ts exists.
NEXT_PUBLIC_LOCALE=ar

# Testing only — point the Google client at a fake server. Leave unset in production.
# GOOGLE_API_BASE_URL=
# GOOGLE_TOKEN_URL=
# MONDAY_API_URL=
